# Cadena de conexión a MySQL
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://root:password@localhost:3306/tienda_tenis"

# NextAuth
NEXTAUTH_SECRET="genera-un-secreto-largo-y-aleatorio-aqui"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del admin que crea el script de seed
ADMIN_EMAIL="admin@tienda.com"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Administrador"

# Cloudinary (para subir imágenes de productos desde el panel admin)
# Crea una cuenta gratis en https://cloudinary.com y toma estos 3 datos
# desde el Dashboard de tu cuenta.
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# WhatsApp Cloud API (oficial, Meta) — bot de creación automática de productos
WHATSAPP_TOKEN="tu-token-permanente"
WHATSAPP_PHONE_NUMBER_ID="el-id-del-numero-que-copiaste-en-meta"
WHATSAPP_VERIFY_TOKEN="la-palabra-secreta-que-inventaste"
WHATSAPP_ALLOWED_NUMBERS="573192934969,573246405015"
APP_URL="https://tu-tienda.vercel.app"
TALLAS_DEFECTO="36,37,38,39,40,41"
STOCK_DEFECTO="5"

# Clave secreta para el endpoint de limpieza automática de productos (cron job)
CRON_SECRET="genera-una-clave-larga-y-aleatoria-para-el-cron"
